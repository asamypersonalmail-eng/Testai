{
  "name": "Telegram Bot Workflow",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [260, 300],
      "webhookId": "telegram-bot-webhook",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot - Testai"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-start-command",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/start",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-start-command",
      "name": "Is /start command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "welcome-text",
              "name": "replyText",
              "type": "string",
              "value": "=Welcome! I'm your Testai bot. Send me any message and I'll echo it back."
            }
          ]
        },
        "options": {}
      },
      "id": "set-welcome-message",
      "name": "Build Welcome Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 180]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "echo-text",
              "name": "replyText",
              "type": "string",
              "value": "=You said: {{ $json.message.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-echo-message",
      "name": "Build Echo Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 420]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.replyText }}",
        "additionalFields": {}
      },
      "id": "telegram-send-reply",
      "name": "Send Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 300],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot - Testai"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Is /start command?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is /start command?": {
      "main": [
        [
          {
            "node": "Build Welcome Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Echo Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Welcome Message": {
      "main": [
        [
          {
            "node": "Send Telegram Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Echo Message": {
      "main": [
        [
          {
            "node": "Send Telegram Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
