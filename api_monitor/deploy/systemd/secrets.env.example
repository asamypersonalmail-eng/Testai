APIMON_ESB_API_KEY=replace-me
APIMON_SOAP_PASSWORD=replace-me
APIMON_EMAIL_API_KEY=replace-me
APIMON_EMAIL_API_PASSWORD=replace-me
# Approved synthetic test identities (never real customer data)
APIMON_TEST_ACCOUNT_NUMBER=replace-me
APIMON_TEST_CARD_REFERENCE=replace-me
APIMON_TEST_CUSTOMER_ID=replace-me
APIMON_POSITION_CUSTOMER_ID=replace-me   # synthetic test customer for getPosition
