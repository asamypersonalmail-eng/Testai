# Copy this file to .env and adjust for your environment.
# Never commit .env — it may contain environment-specific paths.

# Absolute path to the findtrace executable on this server.
FINDTRACE_PATH=/usr/local/bin/findtrace

# Maximum time (in seconds) a single findtrace search may run before it is
# killed and the API returns a timeout error.
FINDTRACE_TIMEOUT=60

# Maximum size (in bytes) of findtrace output the backend will buffer and
# return to the browser. Output beyond this is truncated. Default: 10 MiB.
MAX_OUTPUT_SIZE=10485760

# Port the web server listens on.
PORT=8080
